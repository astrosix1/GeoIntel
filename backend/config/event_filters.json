{
  "_comment": "Tunables for the event quality pipeline (backend/event_pipeline/). Keyword lists are matched on word boundaries (see event_pipeline/keywords.py), never as raw substrings. Edit here — no code change needed. See docs/EVENT_FILTERING.md.",

  "outlets": {
    "_comment": "event_pipeline/relevance.py check_outlet(). Applied to NewsAPI articles and GDELT source URLs. blocked_domains match the host or any subdomain. blocked_sections match a URL path segment exactly or as a prefix ('sports' matches /sports/ and /sports-news/). min_reliability is checked against config/source_reliability.json (outlets not listed score default_reliability); 0 disables it.",
    "blocked_domains": ["prnewswire.com", "globenewswire.com", "businesswire.com", "accesswire.com",
                        "einpresswire.com", "newswire.com", "prweb.com", "openpr.com", "biztoc.com",
                        "crash.net", "motorsport.com", "autosport.com", "formula1.com", "espn.com",
                        "espncricinfo.com", "cricbuzz.com", "skysports.com", "bleacherreport.com",
                        "goal.com", "marca.com", "si.com", "sportskeeda.com", "fansided.com", "nba.com",
                        "nfl.com", "mlb.com", "tmz.com", "eonline.com", "people.com", "variety.com",
                        "hollywoodreporter.com", "deadline.com", "billboard.com", "rollingstone.com",
                        "ign.com", "gamespot.com", "fool.com", "seekingalpha.com", "benzinga.com",
                        "marketbeat.com", "zacks.com", "investorplace.com"],
    "blocked_outlet_names": ["Biztoc.com", "PR Newswire", "Globe Newswire", "GlobeNewswire", "Business Wire",
                             "ESPN", "Sky Sports", "TMZ", "E! Online", "The Motley Fool", "MarketBeat",
                             "Seeking Alpha", "Benzinga", "Yahoo Entertainment", "Yahoo Sports",
                             "Bleacher Report", "Sports Illustrated", "Crash.net", "Motorsport.com"],
    "blocked_sections": ["sport", "sports", "football", "soccer", "cricket", "tennis", "golf", "rugby",
                         "f1", "formula-1", "formula1", "motorsport", "racing", "nba", "nfl", "mlb",
                         "entertainment", "celebrity", "celebrities", "showbiz", "lifestyle", "life-style",
                         "film", "films", "movies", "music", "tv", "television", "gaming", "games",
                         "travel", "food", "recipes", "horoscope", "horoscopes", "astrology", "fashion",
                         "style", "beauty", "obituaries", "obituary", "markets", "personal-finance",
                         "opinion", "opinions", "editorial", "editorials", "reviews", "auto", "autos", "cars",
                         "real-estate", "property", "weather"],
    "min_reliability": 0,
    "default_reliability": 65
  },

  "news_relevance": {
    "_comment": "event_pipeline/relevance.py check_news(). A news article needs an ACTOR signal (a roster actor, a country name/demonym, a role term, or a military-action term that implies an armed actor) as well as the crisis keyword the connector already required, and must not hit negative_topics — unless it names at least strong_actor_min distinct roster actors (states), in which case the geopolitical framing wins.",
    "role_terms": ["government", "minister", "ministry", "president", "prime minister", "parliament",
                   "lawmakers", "senate", "congress", "military", "army", "navy", "air force", "troops",
                   "soldiers", "armed forces", "rebels", "militants", "insurgents", "jihadists",
                   "militia", "junta", "regime", "opposition", "nato", "united nations", "un",
                   "security council", "european union", "african union", "ceasefire", "embassy",
                   "ambassador", "diplomat", "diplomats", "sanctions", "border guards", "coast guard",
                   "hamas", "hezbollah", "houthis", "taliban", "al-shabaab", "isis", "wagner",
                   "paramilitary", "rapid support forces", "idf", "irgc", "pentagon", "kremlin"],
    "military_action_terms": ["missile", "missiles", "airstrike", "air strike", "drone strike", "drone attack",
                              "shelling", "artillery", "rocket attack", "rockets", "bombardment", "invasion",
                              "coup", "ceasefire", "air raid", "ballistic"],
    "demonyms": ["american", "chinese", "russian", "ukrainian", "iranian", "israeli", "palestinian",
                 "lebanese", "syrian", "iraqi", "yemeni", "saudi", "emirati", "qatari", "turkish",
                 "egyptian", "libyan", "sudanese", "ethiopian", "eritrean", "somali", "kenyan",
                 "nigerian", "malian", "burkinabe", "nigerien", "chadian", "congolese", "rwandan",
                 "ugandan", "south african", "algerian", "moroccan", "tunisian", "afghan", "pakistani",
                 "indian", "bangladeshi", "burmese", "myanmar", "thai", "vietnamese", "filipino",
                 "indonesian", "malaysian", "taiwanese", "japanese", "korean", "north korean",
                 "south korean", "mongolian", "kazakh", "uzbek", "georgian", "armenian", "azerbaijani",
                 "belarusian", "polish", "lithuanian", "latvian", "estonian", "finnish", "swedish",
                 "norwegian", "danish", "german", "french", "british", "italian", "spanish", "greek",
                 "serbian", "kosovar", "bosnian", "hungarian", "romanian", "moldovan", "mexican",
                 "colombian", "venezuelan", "cuban", "haitian", "brazilian", "argentine", "peruvian",
                 "ecuadorian", "bolivian", "chilean", "canadian", "australian"],
    "negative_topics": ["football", "soccer", "cricket", "rugby", "tennis", "golf", "basketball",
                        "baseball", "nba", "nfl", "nhl", "mlb", "premier league", "champions league",
                        "world cup", "olympics", "olympic games", "grand prix", "formula 1", "formula one",
                        "f1", "motogp", "tournament", "playoff", "quarterback", "striker", "midfielder",
                        "goalkeeper", "transfer window", "album", "box office", "celebrity", "actress",
                        "singer", "rapper", "concert", "netflix", "oscars", "grammy", "emmy", "hollywood",
                        "bollywood", "reality show", "fashion week", "lifestyle", "recipe", "horoscope",
                        "earnings call", "quarterly results", "quarterly earnings", "stock market",
                        "share price", "ipo", "dividend", "wall street", "whale", "weather forecast",
                        "traffic accident", "traffic jam", "car crash", "road accident", "lottery",
                        "obituary", "murder", "homicide", "manslaughter", "burglary", "robbery",
                        "stabbing", "drug bust", "fugitive", "nightclub", "tourist", "hurricane",
                        "typhoon", "earthquake", "wildfire", "years ago", "history of", "on this day",
                        "trailer", "video game", "smartphone", "iphone"],
    "strong_actor_min": 2
  },

  "location": {
    "_comment": "event_pipeline/location.py. point_tolerance_km: how far outside the claimed country's 1:50m border a point may sit (coastal cities, ports). offshore_km: a point in open sea is kept if within this distance of the claimed country (straits, territorial waters). confidence_by_precision sets location_confidence (the frontend pins only >= 60, so country-level events show in the list, not as pins).",
    "point_tolerance_km": 25,
    "offshore_km": 150,
    "confidence_by_precision": {"point": 90, "city": 82, "region": 70, "country": 55},
    "government_verbs": ["says", "said", "say", "warns", "warned", "urges", "urged", "condemns", "condemned",
                         "accuses", "accused", "imposes", "imposed", "announces", "announced", "rejects",
                         "rejected", "denies", "denied", "threatens", "threatened", "demands", "demanded",
                         "calls", "called", "signals", "signalled", "signaled", "responds", "responded",
                         "vows", "vowed", "blames", "blamed", "slams", "slammed", "sanctions", "sanctioned",
                         "summons", "summoned", "expels", "expelled", "recognizes", "recognises", "backs",
                         "tells", "told", "pressures", "pressed", "asks", "asked", "hits back", "approves",
                         "approved", "agrees", "agreed", "plans", "considers", "weighs", "insists"],
    "location_prepositions": ["in", "near", "outside", "across", "over", "at", "into", "around", "inside",
                              "throughout", "toward", "towards", "off"],
    "ambiguous_cities": ["washington", "victoria", "georgetown", "san jose", "kingston", "perth", "santiago",
                         "cali", "hyderabad", "cambridge",
                         "richmond", "birmingham", "valencia", "cordoba", "cartagena", "tripoli"],
    "ambiguous_countries": ["georgia", "jordan", "chad", "jersey", "guinea", "niger", "turkey", "mali"]
  },

  "dedup": {
    "_comment": "event_pipeline/dedup.py. Two reports are the same event when they share a canonical URL, or share a country, a type family and a time window AND either: both are city/point-precise within city_distance_km with title similarity >= city_similarity; or title similarity >= any_similarity; or one title is synthesized and they are within same_place_km with similarity >= same_place_synthesized_similarity. Similarity is weighted Jaccard over title words (places, countries and demonyms weigh double).",
    "window_hours": 48,
    "db_lookback_hours": 72,
    "city_distance_km": 50,
    "city_similarity": 0.35,
    "any_similarity": 0.6,
    "same_place_km": 10,
    "same_place_synthesized_similarity": 0.2,
    "type_families": {
      "armed_conflict": ["conflict", "military", "proxy", "terror", "cyber", "infrastructure"],
      "unrest": ["civil_unrest", "leadership_change"],
      "political": ["diplomatic", "alliance", "economic", "trade_war", "sanctions", "election"],
      "humanitarian": ["migration", "resource"]
    },
    "stopwords": ["a", "an", "the", "of", "in", "on", "at", "to", "for", "and", "or", "but", "by", "with",
                  "from", "as", "is", "are", "was", "were", "be", "been", "it", "its", "this", "that",
                  "after", "amid", "over", "into", "near", "says", "said", "say", "new", "report",
                  "reports", "reported", "involving", "uses", "against", "latest", "update", "news"]
  },

  "lifecycle": {
    "_comment": "Active rows not reported by any sync for ttl_days (by source prefix) are deactivated (is_active=False, never deleted). Rows from exempt_sources, status 'upcoming', or human-verified are never expired.",
    "ttl_days": {"GDELT": 3, "NewsAPI": 7, "NEWS_API_": 7, "ACLED": 30},
    "exempt_sources": ["CURATED", "Sample Data", "MANUAL"]
  },

  "gdelt_rules": {
    "_comment": "event_pipeline/relevance.py check_gdelt(). Codes are CAMEO base codes matched by prefix. A 'geopolitical' actor has a Type1Code in geopolitical_actor_types, or is a bare state (actor code == its country code, e.g. RUS). 'Interstate' means both actors are geopolitical and from different countries.",
    "require_root_event": true,
    "geopolitical_actor_types": ["GOV", "MIL", "REB", "INS", "SEP", "OPP", "IGO", "UAF", "SPY", "LEG", "PTY"],
    "armed_actor_types": ["MIL", "REB", "INS", "UAF", "SEP"],
    "dropped_codes": ["170", "171"],
    "standalone_prefixes": ["138", "15", "172", "173", "174", "175", "176", "18", "19", "20"],
    "interstate_only_prefixes": ["10", "11", "12", "13", "16"],
    "protest": {"prefix": "14", "min_articles": 5, "actor_types": ["OPP", "GOV"]},
    "domestic_actor_types": {
      "_comment": "For events inside one country, a bare country code (GDELT often codes a place like 'Kansas City' as USA) doesn't count — at least one actor must carry one of these Type1Codes for the event-code prefix. 'default' covers any prefix not listed.",
      "18": ["MIL", "REB", "INS", "UAF", "SEP"],
      "19": ["MIL", "REB", "INS", "UAF", "SEP"],
      "20": ["MIL", "REB", "INS", "UAF", "SEP", "GOV"],
      "17": ["OPP", "REB", "INS", "SEP", "MIL", "SPY", "LEG", "PTY"],
      "default": ["GOV", "MIL", "REB", "INS", "SEP", "OPP", "IGO", "UAF", "SPY", "LEG", "PTY"]
    },
    "corroboration": {"min_sources": 2, "min_articles": 3, "exempt_prefixes": ["19", "20"]},
    "check_headline_topics": true
  },

  "acled_rules": {
    "_comment": "event_pipeline/relevance.py check_acled(). Events with fatalities are always kept.",
    "drop_without_fatalities": ["Peaceful protest", "Other", "Change to group/activity",
                                "Headquarters or base established", "Looting/property destruction"],
    "strategic_developments_keep": ["Agreement", "Arrests", "Disrupted weapons use",
                                    "Non-violent transfer of territory"],
    "state_actor_markers": ["Military Forces of", "Police Forces of", "Government of"]
  },

  "news_crisis_keywords": {
    "_comment": "Order matters: the first type with a hit wins, so leadership_change and civil_unrest come before conflict/military (a coup or protest story often also says 'armed'/'military').",
    "leadership_change": ["coup", "ousted", "overthrown", "seized power", "junta", "assassinated",
                          "resigns as president", "unconstitutional", "succession crisis"],
    "civil_unrest": ["protest", "unrest", "riot", "demonstrators", "uprising", "crackdown",
                     "mass arrests", "general strike"],
    "conflict": ["war", "combat", "fighting", "battle", "attack", "strike", "bomb", "military",
                 "armed", "clash"],
    "military": ["military", "deployment", "exercise", "buildup", "troops", "forces", "defense"],
    "diplomatic": ["diplomatic", "crisis", "tensions", "talks", "negotiations", "standoff",
                   "peace deal", "peace agreement", "ceasefire signed", "ceasefire agreed"],
    "alliance": ["alliance", "joins nato", "treaty signed", "accession", "mutual defense pact",
                 "normalizes relations"],
    "economic": ["economic", "embargo", "sanction", "trade", "crisis", "collapse"],
    "resource": ["resource", "oil", "gas", "commodity", "supply", "shortage"],
    "technology": ["technology", "cyber", "ai", "chip", "semiconductor"],
    "proxy": ["proxy", "indirect", "support", "militia"]
  },

  "scoring": {
    "_comment": "event_pipeline/scoring.py. Two 0-100 scores. severity = LOCAL intensity (how violent/serious on the ground): class_base[event class] + fatality bucket + one scale word, then caps. global_impact = INTERNATIONAL significance (drives globe emphasis, the critical badge and default sort): a share of severity plus international-scope bonuses, then caps; >= 80 also needs two of critical_requirements. Bands (both scores): critical >= 80, high >= 60, elevated >= 35, low < 35.",
    "bands": {"critical": 80, "high": 60, "elevated": 35},
    "class_base": {"verbal": 10, "threat": 20, "protest": 15, "riot": 25, "posture": 25, "repression": 25,
                   "assault": 40, "armed_clash": 45, "aerial": 50, "mass_violence": 60},
    "fatality_buckets": [[500, 40], [100, 32], [25, 25], [5, 15], [1, 8]],
    "scale_words": {"hundreds": 10, "thousands displaced": 8, "thousands": 8, "dozens": 5},
    "severity_caps": {"verbal": 30, "protest_without_fatalities": 40, "single_unverified_source": 65},
    "impact": {
      "severity_share": 0.4, "severity_share_max_input": 50,
      "interstate": 20, "interstate_military": 15,
      "nuclear_party": 12, "two_nuclear_parties": 20,
      "great_power_party": 8, "strategic_location": 8, "escalation_term": 10,
      "corroboration": [[25, 10], [10, 6], [3, 3]],
      "mass_casualties": [[100, 15], [25, 5]],
      "caps": {"domestic": 55, "single_source": 60, "verbal_only": 50},
      "critical_requirements": ["interstate", "nuclear_party", "deaths_100", "sources_10"]
    },
    "nuclear_states": ["United States", "Russia", "China", "United Kingdom", "France", "India", "Pakistan",
                       "North Korea", "Israel"],
    "great_powers": ["United States", "Russia", "China"],
    "escalation_terms": ["declares war", "declared war", "invasion", "invades", "nuclear test", "ballistic missile",
                         "martial law", "general mobilization", "no-fly zone", "chemical weapons",
                         "nuclear strike", "tactical nuclear"],
    "strategic_locations": [
      {"name": "Strait of Hormuz", "keywords": ["hormuz"], "bbox": [25.0, 54.5, 27.5, 57.5], "at_sea_only": true},
      {"name": "Taiwan Strait", "keywords": ["taiwan strait"], "bbox": [22.0, 117.0, 26.5, 121.0], "at_sea_only": true},
      {"name": "Bab-el-Mandeb", "keywords": ["bab el-mandeb", "bab al-mandab", "red sea"], "bbox": [11.5, 42.5, 16.0, 44.5], "at_sea_only": true},
      {"name": "Suez Canal", "keywords": ["suez"], "bbox": [29.5, 32.0, 31.5, 33.0], "at_sea_only": false},
      {"name": "Strait of Malacca", "keywords": ["malacca"], "bbox": [0.5, 98.0, 6.5, 104.5], "at_sea_only": true},
      {"name": "Black Sea", "keywords": ["black sea"], "bbox": [40.5, 27.5, 47.0, 42.0], "at_sea_only": true},
      {"name": "South China Sea", "keywords": ["south china sea", "spratly", "paracel", "scarborough shoal", "second thomas shoal"], "bbox": [3.0, 105.0, 23.0, 121.0], "at_sea_only": true},
      {"name": "Baltic Sea", "keywords": ["baltic sea"], "bbox": [53.5, 9.5, 66.0, 30.5], "at_sea_only": true},
      {"name": "Korean DMZ", "keywords": ["dmz", "demilitarized zone", "panmunjom"], "bbox": [37.7, 126.0, 38.4, 129.0], "at_sea_only": false},
      {"name": "Zaporizhzhia nuclear plant", "keywords": ["zaporizhzhia nuclear", "nuclear power plant"], "bbox": [47.4, 34.5, 47.6, 34.7], "at_sea_only": false}
    ]
  },

  "news_event_classes": {
    "_comment": "Event class for a news article: the first class whose keywords appear (word-boundary) wins, so order matters (most severe first). Articles with none fall back to type_defaults by crisis type.",
    "mass_violence": ["massacre", "genocide", "ethnic cleansing", "chemical weapons", "chemical attack", "nuclear strike",
                      "coup", "mass killing", "mass killings"],
    "aerial": ["airstrike", "air strike", "air raid", "missile", "missiles", "drone strike", "drone attack", "drones",
               "bombardment", "shelling", "artillery", "rocket", "rockets"],
    "armed_clash": ["clash", "clashes", "fighting", "battle", "offensive", "combat", "firefight", "gunfight", "skirmish"],
    "assault": ["bombing", "bomb", "explosion", "suicide attack", "assassination", "assassinated", "ambush",
                "kidnapped", "abducted", "hostage", "attack", "gunmen", "massacred"],
    "repression": ["crackdown", "arrested", "detained", "mass arrests", "tear gas", "jailed"],
    "riot": ["riot", "rioting", "violent protest", "looting"],
    "protest": ["protest", "demonstration", "demonstrators", "rally", "march", "general strike", "sit-in"],
    "posture": ["troops", "deployment", "deployed", "exercise", "drills", "mobilization", "buildup", "warship",
                "warships", "fighter jets", "incursion"],
    "threat": ["threatens", "threatened", "sanctions", "sanction", "ultimatum", "expels", "expelled", "embargo",
               "warns", "warned", "retaliate", "retaliation"],
    "type_defaults": {"conflict": "posture", "military": "posture", "proxy": "posture", "civil_unrest": "protest",
                      "leadership_change": "repression", "diplomatic": "verbal", "alliance": "verbal",
                      "economic": "threat", "resource": "threat", "technology": "threat", "cyber": "threat"}
  },

  "titles": {
    "_comment": "event_pipeline/titles.py. known_outlets are stripped when they trail or lead a headline (in addition to the article's own outlet name and domain). acronyms stay upper-case when an ALL-CAPS headline is re-cased.",
    "known_outlets": ["Reuters", "AP", "AP News", "Associated Press", "AFP", "Bloomberg", "BBC", "BBC News",
                      "CNN", "Al Jazeera", "Al Jazeera English", "The Guardian", "Guardian", "Financial Times", "FT",
                      "The New York Times", "New York Times", "NYT", "The Washington Post", "Washington Post",
                      "The Wall Street Journal", "WSJ", "NPR", "CBS News", "NBC News", "ABC News", "Fox News",
                      "Sky News", "DW", "Deutsche Welle", "France 24", "Euronews", "Politico", "Politico Europe",
                      "Axios", "The Hill", "Newsweek", "Time", "The Economist", "The Independent", "The Telegraph",
                      "The Times", "Times of India", "The Times of India", "Hindustan Times", "Dawn", "Xinhua",
                      "TASS", "RT", "Kyiv Independent", "Kyiv Post", "Times of Israel", "The Times of Israel",
                      "Haaretz", "Jerusalem Post", "The Jerusalem Post", "Arab News", "South China Morning Post",
                      "SCMP", "Nikkei Asia", "Yonhap", "The Japan Times", "ABC", "News.com.au", "Yahoo News",
                      "Yahoo", "MSN", "Breitbart News", "Breitbart", "ZeroHedge", "Business Insider",
                      "Voice of America", "VOA", "RFE/RL", "Radio Free Europe/Radio Liberty", "Anadolu Agency",
                      "Middle East Eye", "The National", "Channel News Asia", "CNA", "The Straits Times"],
    "acronyms": ["UN", "US", "USA", "UK", "EU", "NATO", "IAEA", "ICC", "ICJ", "IMF", "WHO", "WTO", "OPEC",
                 "ASEAN", "AU", "ECOWAS", "BRICS", "G7", "G20", "IDF", "IRGC", "ISIS", "RSF", "SAF", "M23",
                 "PKK", "SDF", "DRC", "UAE", "DPRK", "PLA", "CIA", "FBI", "NSA", "MI6", "FSB", "GRU", "AI",
                 "PM", "MP", "MPs", "OSCE", "UNSC", "UNHCR", "UNICEF", "WFP", "ICRC"],
    "min_words": 3,
    "min_chars": 15
  },

  "phrase_exclusions": {
    "_comment": "Idioms removed from text before keyword matching, so e.g. 'heart attack' never counts as an attack.",
    "phrases": ["heart attack", "heart attacks", "panic attack", "panic attacks", "asthma attack",
                "shark attack", "shark attacks", "dog attack", "price war", "price wars",
                "bidding war", "console war", "streaming war", "streaming wars", "talent war",
                "culture war", "culture wars", "star wars", "war room", "charm offensive",
                "brain drain", "lightning strike", "lightning strikes", "strike a deal",
                "strike a balance"]
  }
}
