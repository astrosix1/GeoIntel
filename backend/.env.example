# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real credentials.

# NewsAPI.org — powers NewsAPIConnector, NewsBasedCrisisDetector, and the
# multilingual news sync (all three read this same variable).
# Free key: https://newsapi.org/register
# Free-tier limits: 100 requests/day, articles delayed 24h, and the terms
# restrict free-tier use to localhost/development — fine for local dev,
# but a real deployment would need their paid Business plan.
NEWSAPI_KEY=

# ACLED — powers ACLEDConnector (real conflict event data).
# Register a myACLED account first: https://acleddata.com/register
# These are your ACLED account login, not a static API key — the app
# exchanges them for a short-lived OAuth token itself (see
# ACLEDConnector._get_access_token in data_sources.py).
ACLED_EMAIL=
ACLED_PASSWORD=
